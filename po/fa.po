msgid "Previous Item"
msgstr "آیتم قبلی"

msgid "Next Item"
msgstr "آیتم بعدی"

msgid "Clear History"
msgstr "پاک‌کردن تاریخچه"

msgid "Settings"
msgstr "تنظیمات"

msgid "Capture"
msgstr "ضبط"

msgid "[Image]"
msgstr "[تصویر]"

msgid "Clipboard"
msgstr "کلیپ‌بورد"

msgid "Clipboard updated"
msgstr "کلیپبورد بروز شد"

msgid "Clipboard capture enabled"
msgstr "ضبط کلیپبورد فعال شد"

msgid "Clipboard capture paused"
msgstr "ضبط کلیپبورد موقتاً متوقف شد"

msgid "Gnome Clipboard"
msgstr "Gnome Clipboard"

msgid "Clear history?"
msgstr "پاک کردن تاریخچه"

msgid "Are you sure you want to remove all items?"
msgstr "آیا اطمینان دارید که می‌خواهید همه آیتمها را حذف کنید؟"

msgid "Empty"
msgstr "خالی"

msgid "Cancel"
msgstr "لغو"

msgid "OK"
msgstr "تایید"

msgid "Pinned"
msgstr "سنجاق‌شده"

msgid "Recent History"
msgstr "تاریخچه اخیر"

msgid "Clipboard is empty"
msgstr "کلیپ‌بورد خالی است"

msgid "Pin"
msgstr "سنجاق کردن"

msgid "Unpin"
msgstr "برداشتن سنجاق"

msgid "Delete"
msgstr "حذف"

msgid "Just now"
msgstr "همین حالا"

msgid "1 minute ago"
msgstr "1 دقیقه پیش"

#, javascript-format
msgid "%d minutes ago"
msgstr "%d دقیقه پیش"

#, javascript-format
msgid "%d hours ago"
msgstr "%d ساعت پیش"

msgid "1 hour ago"
msgstr "1 ساعت پیش"

#, javascript-format
msgid "%d days ago"
msgstr "%d روز پیش"

msgid "1 day ago"
msgstr "1 روز پیش"

msgid "Preferences"
msgstr "ترجیحات"

msgid "Maximum size of history:"
msgstr "بیشترین تعداد تاریخچه"

msgid "Read clipboard by timer:"
msgstr "خواندن کلیپ‌بورد با تایمر:"

msgid "Timer interval (Millisecond):"
msgstr "بازه زمانی تایمر (میلی ثانیه)"

msgid "Save only pinned items:"
msgstr "فقط آیتم‌های سنجاق‌شده ذخیره شود:"

msgid "Show notifications"
msgstr "نمایش اعلان‌ها"

msgid "Data folder"
msgstr "پوشهٔ داده"

msgid "Open the folder where clipboard history is stored"
msgstr "پوشه‌ای را که تاریخچهٔ بریده‌دان در آن ذخیره می‌شود باز کنید"

msgid "Open"
msgstr "باز کردن"

msgid "Images"
msgstr "تصاویر"

msgid "Store images:"
msgstr "ذخیرهٔ تصاویر:"

msgid "Save images copied to the clipboard in the history"
msgstr "تصاویر رونوشت‌شده در بریده‌دان را در تاریخچه ذخیره کن"

msgid "Maximum image size (MB):"
msgstr "حداکثر اندازهٔ تصویر (مگابایت):"

msgid "Ignore images larger than this size"
msgstr "تصاویر بزرگ‌تر از این اندازه نادیده گرفته شوند"

msgid "Privacy"
msgstr "حریم خصوصی"

msgid "Blacklisted App IDs"
msgstr "شناسه برنامه‌های مسدودشده"

msgid "Keyboard Shortcuts"
msgstr "میانبرهای صفحه‌کلید"

msgid "Use formats like <Super>v, <Control><Alt>c, etc."
msgstr "از قالب‌هایی مانند <Super>v، <Control><Alt>c و غیره استفاده کنید."

msgid "Toggle History Menu"
msgstr "باز/بسته کردن منوی تاریخچه"

msgid "Select Next Item"
msgstr "انتخاب آیتم بعدی"

msgid "Select Previous Item"
msgstr "انتخاب آیتم قبلی"

msgid "Toggle Capture"
msgstr "تغییر حالت ضبط"

msgid "None"
msgstr "هیچ‌کدام"

msgid "New shortcut..."
msgstr "میانبر جدید..."

msgid "Search clipboard..."
msgstr "جست‌وجو در کلیپ‌بورد..."

